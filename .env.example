# ==============================================================================
# IncuBrix Long-Tail Distribution Network - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit real credentials, production secrets, or private tokens to Git.
# ==============================================================================

# Application Runtime
APP_ENV=development
APP_NAME=incubrix-distribution
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
SIMULATION_MODE=true

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://incubrix_user:incubrix_password@localhost:5432/incubrix_db
DATABASE_SYNC_URL=postgresql://incubrix_user:incubrix_password@localhost:5432/incubrix_db

# Redis (Queue & Caching)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 Compatible)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=incubrix_minio_admin
S3_SECRET_KEY=incubrix_minio_secret_key_change_in_prod
S3_BUCKET_NAME=incubrix-artifacts
S3_SECURE=false

# Security & Signatures
WEBHOOK_SIGNING_SECRET=whsec_dev_placeholder_signing_key_32chars
API_ACCESS_TOKEN=incubrix_demo_reviewer_token_2026

# Target Platform / Sandbox URLs (Local or Mock Platforms)
MOCK_PLATFORMS_URL=http://localhost:8080
LEMMY_API_URL=http://localhost:8536
GHOST_API_URL=http://localhost:2368
